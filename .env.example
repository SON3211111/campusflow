# ─── MySQL ───────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=teamdb
MYSQL_USER=teamuser
MYSQL_PASSWORD=teampassword

# ─── Spring Boot ─────────────────────────────────────
